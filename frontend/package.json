{
  "name": "vinax",
  "private": true,
  "version": "5.7.0",
  "description": "VinaX frontend — music tuned to you. No login. Private by design. (Cloudflare Pages)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild:clean": "rm -rf dist node_modules/.vite node_modules/.vite-temp node_modules/.rolldown node_modules/.cache .vite",
    "build": "npm run prebuild:clean && tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name vinax",
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "cap:sync": "npm run build && npx cap sync android && node scripts/patch-android.js",
    "cap:add:android": "npx cap add android && node scripts/patch-android.js",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "test": "vitest run",
    "e2e": "node scripts/e2e-smoke.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@tanstack/react-query": "^5.59.0",
    "@types/katex": "^0.16.8",
    "@types/qrcode": "^1.5.6",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.26.2",
    "web-vitals": "^5.3.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^25.0.0",
    "playwright-core": "^1.48.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
