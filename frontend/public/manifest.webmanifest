{
  "name": "VinaX",
  "short_name": "VinaX",
  "description": "Free music in 12 Indian languages. Sign in with Google or email, no subscription.",
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment"],
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/icons/icon-192.png?v=14",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png?v=14",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon.svg?v=14",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "orientation": "portrait",
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Search", "short_name": "Search", "url": "/search", "icons": [{ "src": "/icons/icon-192.png?v=14", "sizes": "192x192" }] },
    { "name": "Liked Songs", "short_name": "Liked", "url": "/favorites", "icons": [{ "src": "/icons/icon-192.png?v=14", "sizes": "192x192" }] },
    { "name": "Listen Later", "short_name": "Later", "url": "/later", "icons": [{ "src": "/icons/icon-192.png?v=14", "sizes": "192x192" }] }
  ]
}
