<?xml version="1.0" encoding="utf-8"?>
<!-- Shared widget surface: dark, slightly translucent, rounded, with a faint
     violet hairline so the card reads on both light and dark wallpapers. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/vinax_widget_surface" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/vinax_widget_surface_stroke" />
</shape>
