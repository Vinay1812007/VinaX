# VinaX web search — copy to .env (never commit .env) and fill in all three.

# The DNS name that points at this machine, e.g. search.example.org
# (an A/AAAA record; ports 80 and 443 open). No scheme, no slash.
SEARXNG_HOSTNAME=

# SearXNG's own secret (server.secret_key). Generate: openssl rand -hex 32
SEARXNG_SECRET=

# The token the VinaX Worker sends. Generate: openssl rand -hex 32
# Set the SAME value on the Worker (from backend/):
#   npx wrangler secret put SEARXNG_TOKEN --config worker/wrangler.toml
SEARXNG_TOKEN=

# Only while rotating the token (README.md, Maintenance): the old value, still
# accepted until the Worker has the new one. Remove it afterwards.
# SEARXNG_TOKEN_PREVIOUS=
