# VinaX web search — only for running the image locally. On Render these are
# set in the dashboard (see ../../render.yaml); copy this to .env and never
# commit it.
#
#   docker build -t vinax-search deploy/searxng
#   docker run --rm --env-file deploy/searxng/.env -p 10000:10000 vinax-search
#   curl -s -H "Authorization: Bearer $SEARXNG_TOKEN" \
#        'http://localhost:10000/search?q=telugu+songs&format=json' | head -c 400
#
# Without the header that last call must answer 401. If it answers results,
# stop and fix it before putting the instance on a public hostname.

# The engine's own server.secret_key. Generate: openssl rand -hex 32
SEARXNG_SECRET=

# The token the VinaX Worker sends. Generate: openssl rand -hex 32
# The SAME value goes on the Worker (from backend/):
#   npx wrangler secret put SEARXNG_TOKEN --config worker/wrangler.toml
SEARXNG_TOKEN=

# Only while rotating the token: the old value, still accepted until the
# Worker has the new one. Remove it afterwards.
# SEARXNG_TOKEN_PREVIOUS=

# What the engine thinks its own address is. Locally this can stay unset.
# SEARXNG_BASE_URL=https://search.sirimillavinay.online/
