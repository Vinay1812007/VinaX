# VinaX web search — the token check in front of the engine.
#
# Render terminates TLS at its edge and Cloudflare in front of that, so this
# listens on plain HTTP on $PORT and issues no certificate of its own
# (auto_https off). It is never reachable except through those two.
#
# What gets through:
#   GET /search  with `Authorization: Bearer $SEARXNG_TOKEN`  → the engine
#   GET /healthz (no token)                                   → "ok", answered
#                here, never forwarded, so it reveals nothing about the engine
#                and keeps answering while the engine is still starting
#   everything else                                           → 401 or 404
#
# The token is compared as an exact string and stripped before the request
# reaches the engine. While rotating, SEARXNG_TOKEN_PREVIOUS is accepted too;
# start.sh defaults it to the current token so an unset variable can never
# widen the match to `Bearer `.
#
# The access log never records the search words: the `q` query parameter is
# deleted from every logged request, and Authorization is never logged.

{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	encode gzip

	handle /healthz {
		respond "ok" 200
	}

	@vinax {
		method GET
		path /search
		# Two values of one header field are OR'd: the current token, or the
		# previous one during a rotation.
		header Authorization "Bearer {$SEARXNG_TOKEN}"
		header Authorization "Bearer {$SEARXNG_TOKEN_PREVIOUS}"
	}

	handle @vinax {
		request_header -Authorization
		reverse_proxy 127.0.0.1:8080
	}

	handle /search {
		respond "Unauthorized" 401
	}

	handle {
		respond "Not found" 404
	}

	header {
		-Server
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					delete q
				}
			}
		}
	}
}
