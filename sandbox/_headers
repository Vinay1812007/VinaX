# VinaX AI artifact runner (sandbox.vinaxmusic.online). See DEPLOYMENT.md "VinaX AI sandbox".
# Its own origin, so nothing an artifact runs can reach the app, its storage or its session.
# Model-written code runs here: scripts only from cdnjs and two pinned jsDelivr paths
# (Tailwind's in-browser build and lucide, which cdnjs does not carry), no network
# access at all (connect-src 'none'), framed only by VinaX itself.
/*
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3/ https://cdn.jsdelivr.net/npm/lucide@1.57.0/; style-src 'unsafe-inline' https://cdnjs.cloudflare.com; img-src data: blob: https:; font-src data: https://cdnjs.cloudflare.com; media-src data: blob:; connect-src 'none'; frame-src 'self' blob: data:; form-action 'none'; base-uri 'none'; frame-ancestors https://www.vinaxmusic.online http://localhost:*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cache-Control: public, max-age=300
