{
  "name": "vinax-cli",
  "version": "0.1.0",
  "private": true,
  "description": "VinaX CLI — the VinaX coding agent in your terminal. Reads, edits, runs and commits on your own machine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vinax": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "node --experimental-strip-types src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "vinax",
    "cli",
    "coding-agent",
    "terminal"
  ],
  "license": "UNLICENSED",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
