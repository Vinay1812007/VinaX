{
  "name": "vinax-cli",
  "version": "0.1.0",
  "description": "VinaX CLI \u2014 the VinaX coding agent in your terminal. Reads, edits, runs and commits on your own machine.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vinax": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vinay1812007/VinaX.git",
    "directory": "cli"
  },
  "homepage": "https://www.sirimillavinay.online/VinaXAI/cli/docs/",
  "bugs": {
    "url": "https://github.com/Vinay1812007/VinaX/issues"
  },
  "author": "Vinay1812007 (https://github.com/Vinay1812007)",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "node --experimental-strip-types src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "vinax",
    "vinax-cli",
    "vinax-ai",
    "cli",
    "coding-agent",
    "ai-agent",
    "terminal",
    "developer-tools",
    "automation"
  ],
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
