# `immutable` deliberately DROPPED (2026-08-21): during the stuck-shell outage
# the SPA HTML got cached under /assets/*.js URLs, and `immutable` told
# browsers never to revalidate — not even on reload — so affected users were
# bricked for up to a year with no self-heal possible. Without it, a plain
# reload revalidates (hashed content answers 304 instantly, so the cost is
# one conditional request on explicit reloads only) and the boot self-heal's
# location.reload() can actually flush a poisoned entry.
/assets/*
  Cache-Control: public, max-age=31536000

/icons/*
  Cache-Control: public, max-age=2592000

# Un-hashed static assets that change rarely (PageSpeed "efficient cache
# lifetimes", 4.17.0). 30 days; a rename is the cache-bust if one ever changes.
/fonts/*
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/og.png
  Cache-Control: public, max-age=604800
/manifest.webmanifest
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: no-cache
/admin/app.js
  Cache-Control: no-cache
/admin/index.html
  Cache-Control: no-cache

/assets-404.txt
  Cache-Control: no-store
