/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://cloudflareinsights.com https://saavn.dev https://*.sumit.co https://nepotuneapi.vercel.app https://jiosaavn-api-privatecv8.b4a.run https://lrclib.net https://*.sirimillavinay.online https://www.gstatic.com; media-src https: blob:; img-src https: data: blob:; script-src 'self' 'inline-speculation-rules' 'sha256-wIUKdga3yp6Q/JCvXQMl7xIqcstJSHRF+3yUja9Sy88=' 'sha256-qa23HEpTAU3n7KzonzCxzeaK4O15iHy20HdN0fyugOU=' https://www.gstatic.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src 'self'; form-action 'self'; manifest-src 'self'

/assets/*
